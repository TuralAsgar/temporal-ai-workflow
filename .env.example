# Google AI Studio API Key (Free tier available at https://aistudio.google.com/app/apikey)
# If left empty, the application will automatically run in Simulation Mode with rich mock LLM data.
GEMINI_API_KEY=

# Model to use (default: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Temporal Server Host:Port (default: localhost:7233)
TEMPORAL_HOST_PORT=localhost:7233

# Optional: Set to true to trigger deliberate error without editing code
# (Alternatively, comment/uncomment the deliberate error line in workflow/activities.go)
TRIGGER_ERROR=false
